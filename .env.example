OPENAI_API_KEY=your-key-here
LABELLER_MODEL=
WRITER_MODEL=

# Supabase (project URL and the PUBLISHABLE / anon key only. Never put a secret or service_role key here.)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Set to false only for local http development; keep true on Railway
COOKIE_SECURE=true
# Comma-separated site addresses that may send changes, e.g. your Vercel domain
ALLOWED_ORIGINS=

# Only for the optional real-database tests (use a SEPARATE, empty Supabase project, never your real one)
# TEST_SUPABASE_URL=
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
